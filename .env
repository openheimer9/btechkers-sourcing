# ============================================================
# BTECHKERS GLOBAL SOURCING — ENVIRONMENT CONFIGURATION
# Production Deployment Platform: Vercel
# ============================================================

# ── SMTP Mail Server Configuration ──────────────────────────
# Required in: Production, Preview, Development (for live email dispatch)
#
# Standard SMTP host provided by your email hosting provider
# Examples: mail.btechkers.com, smtp.gmail.com, smtp.office365.com, smtp.hostinger.com
SMTP_HOST=mail.spacemail.com

# SMTP port:
# - 587 (Standard with STARTTLS — Recommended)
# - 465 (SSL / TLS)
SMTP_PORT=465

# Set to true if using SSL port 465. If using 587 (STARTTLS), set to false.
SMTP_SECURE=true

# SMTP authentication credentials
SMTP_USER=info@btechkers.com
SMTP_PASS=Ashish@1977

# Optional: Set to false ONLY if your mail server uses a self-signed certificate
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# ── Email Routing ───────────────────────────────────────────
# Inbound recipient email address for sourcing inquiries
CONTACT_TO_EMAIL=info@btechkers.com

# Outbound sender address (must be authorized by your SMTP account)
# Format: "Sender Name" <sender@yourdomain.com>
CONTACT_FROM_EMAIL="Btechkers Sourcing" <info@btechkers.com>
